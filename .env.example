# SecuTrack - variables d environnement (modele)
# Copier ce fichier en .env et remplacer par la vraie connexion PostgreSQL.
# Ne jamais commiter le fichier .env reel.

# Coeur relationnel (User, Asset, Risk, Action) - PostgreSQL via Prisma (ADR-002)
DATABASE_URL="postgresql://user:password@localhost:5432/secutrack?schema=public"

# Journal d activite (collection action_logs) - MongoDB via driver natif (ADR-003)
MONGODB_URI="mongodb://localhost:27017/secutrack"
